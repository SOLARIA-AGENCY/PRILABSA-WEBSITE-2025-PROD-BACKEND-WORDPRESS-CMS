# Prilabsa Website 2025 - Environment Variables Example
# Copy this file to .env and configure as needed

# ============================================================================
# WORDPRESS API CONFIGURATION
# ============================================================================

# WordPress REST API Base URL
# Production: https://productos.prilabsa.com/wp-json
# Local: http://localhost:8000/wp-json (if using local WordPress)
VITE_WP_API_BASE_URL=https://productos.prilabsa.com/wp-json

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

VITE_APP_NAME=Prilabsa
VITE_APP_URL=https://productos.prilabsa.com

# ============================================================================
# NOTES
# ============================================================================
#
# - DO NOT commit .env file to git (already in .gitignore)
# - WordPress API must be accessible from this URL
# - For local development, WordPress must be running first
# - Current setup uses PRODUCTION WordPress (no local needed)
#
