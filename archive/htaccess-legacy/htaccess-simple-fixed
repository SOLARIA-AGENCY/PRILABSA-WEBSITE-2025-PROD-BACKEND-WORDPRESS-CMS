# PRILABSA Website - Configuración Simplificada
# Solucionar problemas de serving de archivos

# Enable rewrite engine
RewriteEngine On

# Set HTTP_AUTHORIZATION for WordPress
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Forzar serving de archivos estáticos directamente
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Forzar serving de imágenes
RewriteRule ^assets/ - [L]
RewriteRule ^images/ - [L]

# WordPress routes
RewriteRule ^wp-admin/ - [L]
RewriteRule ^wp-login.php - [L]
RewriteRule ^wp-json/ - [L]

# API routes
RewriteRule ^api/ - [L]
RewriteRule ^catalogo-productos\.json$ - [L]

# PHP scripts
RewriteRule ^(simple-import|embedded-import|import-products|admin-import|ajax-import-handler|prilabsa-import-plugin)\.php$ - [L]

# Default to index.html for SPA
RewriteRule ^(.*)$ index.html [L]