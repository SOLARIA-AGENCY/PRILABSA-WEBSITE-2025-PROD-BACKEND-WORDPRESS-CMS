Options -MultiViews
RewriteEngine On
RewriteBase /

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options nosniff
    Header set X-Frame-Options DENY
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Access-Control-Allow-Origin "*"

    # Prevent caching of HTML and JSON files (Critical for React updates)
    <FilesMatch "\.(html|htm|json)$">
        FileETag None
        Header unset ETag
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
    </FilesMatch>
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>

# ----------------------------------------------------------------------
# ROUTING LOGIC - WordPress in /wordpress/, React in root
# ----------------------------------------------------------------------

# 1. Don't touch ANYTHING in /wordpress/ directory - let WordPress handle it
RewriteRule ^wordpress/ - [L]

# 2. Internal rewrite for /wp-json to use WordPress
# This makes /wp-json work from root while WordPress is in /wordpress/
RewriteRule ^wp-json/(.*)$ /wordpress/index.php?rest_route=/$1 [L,QSA]

# 3. Internal rewrite for /wp-content and /wp-includes
RewriteRule ^wp-content/(.*)$ /wordpress/wp-content/$1 [L]
RewriteRule ^wp-includes/(.*)$ /wordpress/wp-includes/$1 [L]

# 4. Redirect wp-admin and wp-login to /wordpress/ (visible redirect)
RewriteRule ^wp-admin(.*)$ /wordpress/wp-admin$1 [R=301,L]
RewriteRule ^wp-login\.php$ /wordpress/wp-login.php [R=301,L]

# 5. Serve real files and directories (React assets: JS, CSS, images, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 6. React Router Catch-All
# All other requests serve index.html for client-side routing
RewriteRule ^ /index_v2.html [L]